# Copy to .env (never commit .env) and fill in.

# Private key of the $NULL creator wallet 0xe61C…C712. Only fees in this wallet can be claimed.
# Move the dev-buy $NULL and spare ETH to another wallet first: keep only fees + a little gas ETH here.
PRIVATE_KEY=

# 1 = simulate only (nothing is sent). Set to 0 to go live.
DRY_RUN=1

# Share of the claimed fees that buys back and burns $NULL (5000 = 50%).
BURN_BPS=5000
EVERY_MINUTES=20

# Only claim once at least this much is waiting, so gas stays small next to the fees.
MIN_CLAIM_ETH=0.01
# Most ETH spent on one buyback; anything above carries over to the next run.
MAX_BUY_ETH=0.5
# Allowed price movement between quote and buy (300 = 3%).
SLIPPAGE_BPS=300
# Skip a run when gas is above this.
MAX_GWEI=15
# ETH kept in the wallet for gas.
GAS_RESERVE_ETH=0.003

# Reads go to a public node; transactions go through Flashbots Protect (private, no sandwiching).
READ_RPC=https://ethereum-rpc.publicnode.com
SEND_RPC=https://rpc.flashbots.net/fast
